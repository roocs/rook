@@ -142,6 +143,24 @@ replace = """\
 ---------------------------------------------------------------------
 """
 
+[[tool.bumpversion.files]]
+filename = "CITATION.cff"
+include_bumps = ["release"]
+search = "^version: \"[0-9]+\\.[0-9]+\\.[0-9]\""
+replace = "version: \"{new_version}\""
+regex = true
+
+[[tool.bumpversion.files]]
+filename = "Dockerfile"
+search = "LABEL org.opencontainers.image.version=\"{current_version}\""
+replace = "LABEL org.opencontainers.image.version=\"{new_version}\""
+
+[[tool.bumpversion.files]]
+filename = 'Dockerfile'
+search = "LABEL org.opencontainers.image.created=\"\\d4-\\d2-\\d2T\\d2:\\d2:\\d2Z\""
+replace = "LABEL org.opencontainers.image.created=\"{utcnow:%Y-%m-%dT%H:%M:%SZ}\""
+regex = true
+
 [[tool.bumpversion.files]]
 filename = "src/rook/__version__.py"
 search = "__version__ = \"{current_version}\""
